rules_version = '2';

// Security model in one line: a client may write what it *did*, never what it
// *scored*. Trades are owner-only; discipline scores and leaderboard rows are
// derived server-side by Cloud Functions and are read-only to every client.
//
// This is the whole point of the app. If a client could write its own
// disciplineScore, the leaderboard would rank whoever edits a number best.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function unchanged(field) {
      return !(field in request.resource.data)
        || (field in resource.data && request.resource.data[field] == resource.data[field]);
    }

    // Fields only Cloud Functions may set. A client that tries to write any of
    // them is rejected outright.
    function serverOwnedUnchanged() {
      return unchanged('disciplineScore')
        && unchanged('totalR')
        && unchanged('tradeCount')
        && unchanged('winRate')
        && unchanged('journalStreak')
        && unchanged('badgePoints')
        && unchanged('balance');
    }

    // --- Username claims ----------------------------------------------------
    //
    // One document per username, keyed by the username itself. Uniqueness comes
    // from the document id: Firestore refuses a create on an id that already
    // exists, so two people signing up with the same name at the same instant
    // cannot both win. Checking a query and then writing would race.

    match /usernames/{username} {
      // Readable by anyone, because availability is checked on the sign-up
      // screen before there is an account to authenticate with. Usernames are
      // public anyway — they are printed on every leaderboard row.
      allow read: if true;

      // You may only claim a name for yourself.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      // A claim is permanent. Releasing one would let a name be recycled onto
      // a different person while old posts still carry it.
      allow update, delete: if false;
    }

    // --- Profiles -----------------------------------------------------------

    match /users/{uid} {
      // Profiles are public so the feed can show who wrote a post.
      allow read: if isSignedIn();

      allow create: if isOwner(uid)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.username is string
        // A new account starts with a clean slate. It cannot be born with a
        // score, a badge, or a trade history.
        && request.resource.data.disciplineScore == 100
        && request.resource.data.badgePoints == 0
        && request.resource.data.tradeCount == 0
        && request.resource.data.totalR == 0;

      // Settings are the trader's own; stats are not. The username is fixed at
      // creation — the claim document points at this uid and nothing updates it.
      allow update: if isOwner(uid)
        && serverOwnedUnchanged()
        && unchanged('username')
        && unchanged('createdAt');

      allow delete: if isOwner(uid);

      // --- Trades -----------------------------------------------------------
      //
      // Private by default. Sharing copies a redacted version into /posts
      // rather than opening the whole trade log.
      match /trades/{tradeId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.symbol is string
          && request.resource.data.lots is number
          && request.resource.data.lots > 0
          // A trade without a stop is the one thing this app will not store.
          && request.resource.data.stopPrice is number
          && request.resource.data.entryPrice is number
          && request.resource.data.targetPrice is number
          && request.resource.data.stopPrice != request.resource.data.entryPrice
          && request.resource.data.reason is string
          && request.resource.data.reason.size() >= 10;

        // Entry facts are immutable once written — otherwise a trader could
        // rewrite a loss into a win after the fact, and the journal would be
        // worth nothing.
        allow update: if isOwner(uid)
          && unchanged('entryPrice')
          && unchanged('openedAt')
          && unchanged('direction')
          && unchanged('lots')
          && unchanged('balanceAtEntry')
          && unchanged('violations');

        allow delete: if false;
      }
    }

    // --- Public feed --------------------------------------------------------

    match /posts/{postId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.lesson is string
        && request.resource.data.lesson.size() >= 10
        && request.resource.data.claps == 0
        && request.resource.data.commentCount == 0;

      // Authors may fix their own wording. Clap and comment counters are
      // aggregated by Cloud Functions so they cannot be inflated from a client.
      allow update: if isSignedIn()
        && resource.data.authorId == request.auth.uid
        && unchanged('claps')
        && unchanged('commentCount')
        && unchanged('rMultiple')
        && unchanged('authorId')
        && unchanged('postedAt');

      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000;
        allow update: if isSignedIn() && resource.data.authorId == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }

      // One clap document per user per post, so claps cannot be spammed.
      match /claps/{uid} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }
    }

    // --- Connections --------------------------------------------------------
    //
    // One document per relationship, keyed by the two usernames sorted and
    // joined with a hyphen — a character the username rules exclude, so the id
    // cannot be ambiguous. One document rather than a row each: two rows for
    // one relationship is two rows to keep in step, and they drift.
    //
    // Usernames are carried for display, uids for these rules. Security has to
    // key off request.auth.uid, and a username is not proof of anything.

    match /connections/{pair} {
      // Both branches exist because rules are matched against the *query*, not
      // just the documents it returns. Firestore has to prove up front that a
      // query can only return readable documents, and it can only do that when
      // a filter lines up with a clause here:
      //
      //   where('uids', arrayContains: me)  ->  me in resource.data.uids
      //   where('toUid', isEqualTo: me)     ->  me == resource.data.toUid
      //
      // With only the first clause, listing incoming requests by toUid is
      // rejected outright even though every document it would return is one
      // this user is allowed to read.
      allow read: if isSignedIn()
        && (request.auth.uid in resource.data.uids
            || request.auth.uid == resource.data.toUid
            || request.auth.uid == resource.data.fromUid);

      // You may only send a request as yourself, and it starts unaccepted —
      // otherwise anyone could write themselves into someone's network.
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.accepted == false
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.toUid in request.resource.data.uids;

      // Only the recipient can accept, and accepting is the only edit allowed.
      // Letting the sender flip this would make a request meaningless.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.toUid
        && resource.data.accepted == false
        && request.resource.data.accepted == true
        && unchanged('fromUid')
        && unchanged('toUid')
        && unchanged('uids')
        && unchanged('requestedAt');

      // Either side may withdraw, decline or disconnect — all the same delete.
      allow delete: if isSignedIn() && request.auth.uid in resource.data.uids;
    }

    // --- Profile views ------------------------------------------------------

    match /profileViews/{view} {
      // Only the person being looked at may read their visitor list. A public
      // record of who is watching whom is a different and much worse product.
      allow read: if isSignedIn() && request.auth.uid == resource.data.profileUid;

      // A visit is recorded as the viewer, about someone else.
      allow create, update: if isSignedIn()
        && request.resource.data.viewerUid == request.auth.uid
        && request.resource.data.profileUid != request.auth.uid;

      allow delete: if false;
    }

    // --- Lessons ------------------------------------------------------------
    //
    // Course content, published from the repo. Read-only to everyone.
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
