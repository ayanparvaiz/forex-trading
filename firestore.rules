rules_version = '2';

// Security model in one line: a client may write what it *did*, never what it
// *scored*. Trades are owner-only; discipline scores and leaderboard rows are
// derived server-side by Cloud Functions and are read-only to every client.
//
// This is the whole point of the app. If a client could write its own
// disciplineScore, the leaderboard would rank whoever edits a number best.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /// Whether the person asking runs the app: listed under admins/, which
    /// only the server writes. Admins read what moderation needs; every
    /// change they make goes through the worker (worker/src/admin.js).
    // The words and links nobody may post — in a post, a comment, or the
    // Global and community chats — as the admins list them (the admin panel;
    // config/moderation, written by the worker): one pattern, matched against
    // the whole text in lower case. With no list, nothing is blocked.
    // Private chats are not checked.
    function wordsOk(text) {
      let path = /databases/$(database)/documents/config/moderation;
      return !exists(path)
        || get(path).data.get('pattern', '') == ''
        || !text.lower().matches(get(path).data.pattern);
    }

    // An owner or an admin — not a moderator, who looks after posts and
    // messages and has no need of people's contact details.
    function isFullAdmin() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'admin') != 'moderator';
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function unchanged(field) {
      return !(field in request.resource.data)
        || (field in resource.data && request.resource.data[field] == resource.data[field]);
    }

    /// The community the person asking is in, or '' for none. One at a time,
    /// kept on their profile, and held to their membership (see users).
    function myCommunity() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        .get('communityId', '');
    }

    function communityPath(cid) {
      return /databases/$(database)/documents/communities/$(cid);
    }

    /// Whether community [cid] takes writing from the person asking: always,
    /// unless its admin has locked it — then only from the admin.
    function communityOpenTo(cid) {
      let c = get(communityPath(cid)).data;
      return c.get('locked', false) != true || c.createdBy == request.auth.uid;
    }

    /// A reaction to a message: one each, only your own, from the six the
    /// app offers (app/lib/models/chat.dart, reactionEmojis) — and none on a
    /// message that has been unsent.
    function reactionOk() {
      let before = resource.data.get('reactions', {});
      let after = request.resource.data.get('reactions', {});
      return resource.data.unsent == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && after is map
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in after)
            || after[request.auth.uid] in ['👍', '❤️', '😂', '😮', '😢', '🔥']);
    }

    /// Whether either of two people has blocked the other.
    function blockedEitherWay(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocks/$(b))
        || exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
    }

    /// True when an update touches nothing but the counters.
    function onlyCounters() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['claps', 'commentCount', 'reach']);
    }

    /// A counter may move by one in either direction, and never below zero.
    ///
    /// This is what keeps clapping honest without a server in the loop: a
    /// client can register its own like, but it cannot add fifty, and it
    /// cannot drive the count negative to hide someone else's.
    function withinOne(field) {
      return request.resource.data[field] >= 0
        && request.resource.data[field] >= resource.data[field] - 1
        && request.resource.data[field] <= resource.data[field] + 1;
    }

    // Fields only the stats worker may set (worker/src/index.js, which writes
    // with a service account and so is not subject to these rules). A client
    // that tries to write any of them is rejected outright.
    //
    // ranked decides whether an account appears on the board at all, and
    // statsUpdatedAt is what the worker's throttle reads — a client able to
    // set it into the future could stop its own score ever being corrected.
    // achievements are earned from trades, and only ever added to.
    function serverOwnedUnchanged() {
      return unchanged('disciplineScore')
        && unchanged('totalR')
        && unchanged('tradeCount')
        && unchanged('winRate')
        && unchanged('journalStreak')
        && unchanged('badgePoints')
        && unchanged('balance')
        && unchanged('ranked')
        && unchanged('statsUpdatedAt')
        && unchanged('achievements')
        && unchanged('weekBoard')
        && unchanged('weekScore')
        && unchanged('lastWeekBoard')
        && unchanged('lastWeekScore')
        && unchanged('lastWeekTrades')
        && unchanged('weekTrades')
        && unchanged('weekR')
        && unchanged('journalDay');
    }

    // --- Username claims ----------------------------------------------------
    //
    // One document per username, keyed by the username itself. Uniqueness comes
    // from the document id: Firestore refuses a create on an id that already
    // exists, so two people signing up with the same name at the same instant
    // cannot both win. Checking a query and then writing would race.

    match /usernames/{username} {
      // Readable by anyone, because availability is checked on the sign-up
      // screen before there is an account to authenticate with. Usernames are
      // public anyway — they are printed on every leaderboard row.
      allow read: if true;

      // You may only claim a name for yourself.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      // A claim is permanent. Releasing one would let a name be recycled onto
      // a different person while old posts still carry it.
      allow update, delete: if false;
    }

    // --- Profiles -----------------------------------------------------------

    match /users/{uid} {
      // Profiles are public so the feed can show who wrote a post.
      allow read: if isSignedIn();

      // The name in lower case, which search looks names up by — Firestore
      // can only match the start of a field, and only as written. It has to
      // be the real name: nobody can turn up in a search for a name they do
      // not have.
      // The community you are in, which has to agree with your membership:
      // a new one only with its membership written in the same write, and
      // leaving one only with that membership gone. So nobody is ever in two,
      // or claims one they have not joined.
      function communityIdOk() {
        let before = resource.data.get('communityId', '');
        let after = request.resource.data.get('communityId', '');
        return after is string
          && (after == before
              || ((after == ''
                   || existsAfter(/databases/$(database)/documents/communities/$(after)/members/$(uid)))
                  && (before == ''
                   || !existsAfter(/databases/$(database)/documents/communities/$(before)/members/$(uid)))));
      }

      function nameLowerOk() {
        return request.resource.data.nameLower
          == request.resource.data.displayName.lower();
      }

      allow create: if isOwner(uid)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && nameLowerOk()
        && request.resource.data.username is string
        // A new account starts with a clean slate. It cannot be born with a
        // score, a badge, or a trade history.
        && request.resource.data.disciplineScore == 100
        && request.resource.data.badgePoints == 0
        && request.resource.data.tradeCount == 0
        && request.resource.data.totalR == 0
        // Nobody is born onto the leaderboard; the worker ranks an account
        // once it has closed enough trades to be judged on.
        && !('ranked' in request.resource.data)
        && !('statsUpdatedAt' in request.resource.data)
        // Nor with achievements, or a place on this week's board: those are
        // earned, from trades.
        && !('achievements' in request.resource.data)
        && !('weekBoard' in request.resource.data)
        && !('lastWeekBoard' in request.resource.data)
        && !('lastWeekScore' in request.resource.data);

      // Settings are the trader's own; stats are not. The username is fixed at
      // creation — the claim document points at this uid and nothing updates it.
      //
      // Named rather than merely not-forbidden: an update may touch these six
      // and nothing else. A blocklist of server-owned fields keeps scores safe,
      // but it still lets a client hang any field it likes on a public profile.
      allow update: if isOwner(uid)
        && serverOwnedUnchanged()
        && unchanged('username')
        && unchanged('createdAt')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'nameLower', 'gender', 'language', 'avatarId', 'communityId',
                       'lessonsDone'])
        && communityIdOk()
        // The lessons passed: only the ones there are (app/lib/models/lesson.dart).
        && request.resource.data.get('lessonsDone', []).toSet()
             .hasOnly(['risk', 'stop', 'reward', 'revenge', 'journal'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && nameLowerOk()
        // Mirrors Avatars.all. Unknown ids would fall back to the owl on
        // screen, but there is no reason to store one.
        && request.resource.data.avatarId is int
        && request.resource.data.avatarId >= 1
        && request.resource.data.avatarId <= 24;

      allow delete: if isOwner(uid);

      // --- Blocks -----------------------------------------------------------
      //
      // Who you have blocked, private to you: nobody else can list it.
      //
      // The one exception is the person blocked, who may ask about their own
      // entry and nothing else — "has this account blocked me?" — so their
      // app can show the account as unavailable rather than as a profile
      // that silently refuses everything.
      match /blocks/{blockedUid} {
        allow list, delete: if isOwner(uid);
        allow get: if isOwner(uid)
          || (isSignedIn() && request.auth.uid == blockedUid);
        allow create: if isOwner(uid)
          && blockedUid != uid
          && request.resource.data.keys().hasOnly(['username', 'blockedAt'])
          && request.resource.data.username is string
          && request.resource.data.blockedAt == request.time;
        allow update: if false;
      }

      // --- Saved posts ------------------------------------------------------
      //
      // Posts kept for later. Nobody else's business — not even whose they
      // are; the post itself is read under its own rules when it is opened.
      match /saved/{postId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['savedAt'])
          && request.resource.data.savedAt == request.time;
        allow update: if false;
      }

      // Messages starred, to find again: which conversation and which
      // message, never a copy of it — an unsent message is gone here too.
      // For a chat, who it is with, to open it by.
      match /starred/{starId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys()
               .hasOnly(['conversationId', 'messageId', 'room', 'starredAt', 'otherUid', 'otherUsername'])
          && request.resource.data.keys().hasAll(['conversationId', 'messageId', 'room', 'starredAt'])
          && starId == request.resource.data.conversationId + '__' + request.resource.data.messageId
          && request.resource.data.room is bool
          && request.resource.data.starredAt == request.time;
        allow update: if false;
      }

      // --- Chat preferences -------------------------------------------------
      //
      // What you have deleted "for me": one document per conversation, with
      // the moment you cleared the whole chat and the messages you removed
      // one by one. Nothing is deleted from the conversation itself — the
      // other person keeps every message — and nobody but you can see what
      // you have hidden. Also until when you have muted it: nobody is told
      // that either.
      match /chatPrefs/{chatId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['clearedAt', 'hidden', 'mutedUntil'])
          && (!('clearedAt' in request.resource.data)
              || request.resource.data.clearedAt is timestamp)
          && (!('mutedUntil' in request.resource.data)
              || request.resource.data.mutedUntil is timestamp)
          && (!('hidden' in request.resource.data)
              || (request.resource.data.hidden is list
                  && request.resource.data.hidden.size() <= 5000));
      }

      // --- Devices ----------------------------------------------------------
      //
      // The phones this account gets push notifications on, keyed by their
      // FCM token. Yours alone to see: a token is an address, and nobody
      // else has any business sending to it. The worker, which does the
      // sending, reads them with its own authority. Turning notifications
      // off on a phone deletes its entry.
      match /devices/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['uid', 'platform', 'language', 'updatedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.platform in ['ios', 'android']
          && request.resource.data.language in ['bn', 'en']
          && request.resource.data.updatedAt == request.time;
      }

      // --- Trades -----------------------------------------------------------
      //
      // Private by default. Sharing copies a redacted version into /posts
      // rather than opening the whole trade log.
      match /trades/{tradeId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.symbol is string
          && request.resource.data.lots is number
          && request.resource.data.lots > 0
          // A trade without a stop is the one thing this app will not store.
          && request.resource.data.stopPrice is number
          && request.resource.data.entryPrice is number
          && request.resource.data.targetPrice is number
          && request.resource.data.stopPrice != request.resource.data.entryPrice
          && request.resource.data.reason is string
          && request.resource.data.reason.size() >= 10
          // How they felt, if they said (app/lib/models/trade.dart, TradeMood).
          && request.resource.data.get('mood', 'calm')
               in ['calm', 'fomo', 'fear', 'angry', 'bored'];

        // Violations may be added, and one of them may be cleared.
        //
        // Moving a stop earns a violation after the fact, so the set cannot be
        // frozen at creation. But a trader deciding they did not break a rule
        // after all is exactly what this app exists not to allow, so the only
        // flag that can ever come off is noJournal — and it comes off by
        // writing the lesson, which is the thing it was complaining about.
        function violationsOnlyGrow() {
          return request.resource.data.violations.toSet()
                   .hasAll(resource.data.violations.toSet())
            || resource.data.violations.toSet()
                 .difference(request.resource.data.violations.toSet())
                 .hasOnly(['noJournal']);
        }

        // Entry facts are immutable once written — otherwise a trader could
        // rewrite a loss into a win after the fact, and the journal would be
        // worth nothing.
        allow update: if isOwner(uid)
          && unchanged('entryPrice')
          && unchanged('openedAt')
          && unchanged('direction')
          && unchanged('lots')
          && unchanged('balanceAtEntry')
          // Said once, as it was felt: not rewritten after the result.
          && unchanged('mood')
          && violationsOnlyGrow();

        allow delete: if false;
      }
    }

    // --- Public feed --------------------------------------------------------

    // Who can see a post: anyone, for Global; the members of its community,
    // for a community's; and its author, always.
    //
    // No default for a missing community: every post has one (older ones were
    // backfilled), and a default here lets a query that does not filter by
    // community be taken as allowed — it returned other communities' posts.
    function canSee(post) {
      return post.community == 'global'
        || post.authorUid == request.auth.uid
        || post.community == myCommunity();
    }

    match /posts/{postId} {
      allow read: if isSignedIn() && (canSee(resource.data) || isAdmin());

      function thePost() {
        return get(/databases/$(database)/documents/posts/$(postId)).data;
      }

      // A post is either a trade or a leaderboard position. Posts written
      // before rank sharing existed carry no kind at all, so a missing kind
      // reads as 'trade' rather than as nothing.
      function postKind() {
        return request.resource.data.get('kind', 'trade');
      }

      // A rank post's numbers cannot be checked here yet: discipline is still
      // computed on the device, so there is nothing in Firestore to compare
      // against. What the rule can do is keep them inside the range a real
      // score lives in, which stops the obvious "#1 with 100" from a client
      // that never traded. When trades move to Firestore this becomes an
      // equality check against the author's own user document.
      function rankShapeOk() {
        return request.resource.data.rank is int
          && request.resource.data.rank > 0
          && request.resource.data.disciplineScore is number
          && request.resource.data.disciplineScore >= 0
          && request.resource.data.disciplineScore <= 100;
      }

      // What a post says, in words: its lesson and its reason.
      function postWordsOk() {
        return wordsOk(request.resource.data.get('lesson', '') + ' ' + request.resource.data.get('reason', ''));
      }

      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.lesson is string
        && request.resource.data.lesson.size() >= 10
        && request.resource.data.claps == 0
        && request.resource.data.commentCount == 0
        // To Global, or to the community the author is in.
        && request.resource.data.community is string
        && (request.resource.data.community == 'global'
            || (request.resource.data.community != ''
                && request.resource.data.community == myCommunity()
                && communityOpenTo(request.resource.data.community)))
        && postKind() in ['trade', 'rank', 'question']
        && (postKind() != 'rank' || rankShapeOk())
        && postWordsOk()
        // A question: its words, and no answer picked before anyone answers.
        && (postKind() != 'question' || request.resource.data.lesson.size() <= 500)
        && !('answerId' in request.resource.data);

      // Two separate update paths.
      //
      // An author may fix their own wording but not their own numbers. Anyone
      // signed in may move the counters, because clapping and commenting are
      // things other people do — but only by one at a time, and only the
      // counters. Without Cloud Functions the increment has to happen on the
      // client, so the rule bounds what a client can do with it: a like cannot
      // add fifty, and it cannot quietly rewrite the post while it is there.
      allow update: if isSignedIn()
        && (
          (resource.data.authorUid == request.auth.uid
            && (unchanged('lesson') && unchanged('reason') || postWordsOk())
            // How long it shows, and a hide for being reported, are the
            // server's (worker/src/admin-cron.js): no author puts it back.
            && unchanged('expiresAt')
            && unchanged('hiddenByReports')
            && unchanged('hiddenExpiresAt')
            && unchanged('claps')
            && unchanged('commentCount')
            && unchanged('rMultiple')
            && unchanged('authorUid')
            && unchanged('postedAt')
            // Same reasoning as rMultiple: wording is the author's, results
            // are not. A shared rank stays the rank that was shared.
            && unchanged('kind')
            && unchanged('rank')
            && unchanged('disciplineScore')
            && unchanged('community')
            // On a question, its author picks the best answer — one that is
            // there — or takes the pick back.
            && (unchanged('answerId')
                || (resource.data.get('kind', 'trade') == 'question'
                    && (request.resource.data.answerId == null
                        || exists(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.answerId))))))
          ||
          (onlyCounters()
            && canSee(resource.data)
            && withinOne('claps')
            && withinOne('commentCount')
            && withinOne('reach'))
        );

      allow delete: if isSignedIn()
        && resource.data.authorUid == request.auth.uid;

      // Whether the person asking wrote this post. Deleting a post takes its
      // comments, likes and views with it, so its author may remove those —
      // they are nothing without the post, and would otherwise be left
      // behind where nobody could ever see or remove them.
      function isPostAuthor() {
        return get(/databases/$(database)/documents/posts/$(postId)).data.authorUid
          == request.auth.uid;
      }

      // A like on a comment: your own uid into its list, or out of it, and
      // nothing else.
      function commentLikeOk() {
        let before = resource.data.get('likedBy', []);
        let after = request.resource.data.get('likedBy', []);
        let me = [request.auth.uid].toSet();
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
          && after is list
          && after.size() == after.toSet().size()
          && ((!(request.auth.uid in before) && after.toSet() == before.toSet().union(me))
              || (request.auth.uid in before && after.toSet() == before.toSet().difference(me)));
      }

      // A reply names the comment it answers, on this same post, and whose.
      function commentReplyOk(r) {
        return r is map
          && r.keys().hasOnly(['id', 'authorUid', 'name'])
          && r.keys().hasAll(['id', 'authorUid', 'name'])
          && get(/databases/$(database)/documents/posts/$(postId)/comments/$(r.id)).data.authorUid
               == r.authorUid;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn() && (canSee(thePost()) || isAdmin());
        allow create: if isSignedIn()
          && canSee(thePost())
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000
          && wordsOk(request.resource.data.body)
          // Born with no likes, and a reply only to a real comment.
          && !('likedBy' in request.resource.data)
          && (!('replyTo' in request.resource.data)
              || commentReplyOk(request.resource.data.replyTo));
        // Its author edits their own words — never its likes or what it
        // replies to. Anyone who can see the post likes it, or stops.
        allow update: if isSignedIn()
          && ((resource.data.authorUid == request.auth.uid
               && !request.resource.data.diff(resource.data).affectedKeys()
                     .hasAny(['likedBy', 'replyTo', 'authorUid'])
               && (unchanged('body') || wordsOk(request.resource.data.body)))
              || (canSee(thePost()) && commentLikeOk()));
        allow delete: if isSignedIn()
          && (resource.data.authorUid == request.auth.uid || isPostAuthor());
      }

      // One clap document per user per post, keyed by uid, so a like cannot be
      // spammed however many times the button is pressed.
      //
      // The uid is also stored as a field, and has to match: a document id
      // cannot be queried across posts, so deleting an account finds its
      // likes by this field.
      match /claps/{uid} {
        allow read: if isSignedIn() && (canSee(thePost()) || isAdmin());
        allow create: if isOwner(uid)
          && canSee(thePost())
          && request.resource.data.keys().hasOnly(['uid', 'at'])
          && request.resource.data.uid == uid;
        allow delete: if isOwner(uid) || (isSignedIn() && isPostAuthor());
        allow update: if false;
      }

      // One view document per user per post, for the same reason: reach counts
      // people, not scrolls. Views are never removed — a post that was seen
      // stays seen.
      match /views/{uid} {
        allow read: if isSignedIn() && (canSee(thePost()) || isAdmin());
        allow create: if isOwner(uid) && canSee(thePost());
        allow update: if false;
        // Only with the post itself.
        allow delete: if isSignedIn() && isPostAuthor();
      }
    }

    // --- Connections --------------------------------------------------------
    //
    // One document per relationship, keyed by the two usernames sorted and
    // joined with a hyphen — a character the username rules exclude, so the id
    // cannot be ambiguous. One document rather than a row each: two rows for
    // one relationship is two rows to keep in step, and they drift.
    //
    // Usernames are carried for display, uids for these rules. Security has to
    // key off request.auth.uid, and a username is not proof of anything.

    match /connections/{pair} {
      // An accepted connection is public; a pending one is not.
      //
      // Who is connected to whom is the visible part of any professional
      // network, and profiles show both a count and a list. Keeping that
      // private made it impossible to open anyone else's profile at all. A
      // request that has not been answered is a different matter — it stays
      // between the two people involved until one of them accepts.
      //
      // Each clause exists because rules are matched against the *query*, not
      // just the documents it returns. Firestore has to prove up front that a
      // query can only return readable documents, which it can only do when a
      // filter lines up with a clause here:
      //
      //   where('accepted', isEqualTo: true)  ->  resource.data.accepted == true
      //   where('uids', arrayContains: me)    ->  me in resource.data.uids
      //   where('toUid', isEqualTo: me)       ->  me == resource.data.toUid
      //
      // Drop a clause and the matching query is refused outright, even when
      // every document it would return is one this user may read.
      // get and list are split because they fail differently.
      //
      // Asking for a connection that does not exist is the normal case — it is
      // how the app decides whether to show a Connect button. On a missing
      // document `resource` is null, so every clause below would be reading a
      // field off nothing and the read is refused. A refusal for "no such
      // relationship" is wrong and, worse, indistinguishable from a real
      // permission problem, which is exactly how it broke every profile.
      allow get: if isSignedIn()
        && (resource == null
            || resource.data.accepted == true
            || request.auth.uid in resource.data.uids
            || request.auth.uid == resource.data.toUid
            || request.auth.uid == resource.data.fromUid);

      allow list: if isSignedIn()
        && (resource.data.accepted == true
            || request.auth.uid in resource.data.uids
            || request.auth.uid == resource.data.toUid
            || request.auth.uid == resource.data.fromUid);

      // You may only send a request as yourself, and it starts unaccepted —
      // otherwise anyone could write themselves into someone's network.
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.accepted == false
        // Not between two people where either has blocked the other.
        && !blockedEitherWay(request.resource.data.fromUid, request.resource.data.toUid)
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.toUid in request.resource.data.uids;

      // Only the recipient can accept, and accepting is the only edit allowed.
      // Letting the sender flip this would make a request meaningless.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.toUid
        && resource.data.accepted == false
        && request.resource.data.accepted == true
        && unchanged('fromUid')
        && unchanged('toUid')
        && unchanged('uids')
        && unchanged('requestedAt');

      // Either side may withdraw, decline or disconnect — all the same delete.
      allow delete: if isSignedIn() && request.auth.uid in resource.data.uids;
    }

    // --- Notifications ------------------------------------------------------
    //
    // Written by whoever caused the thing, read only by whoever it happened to.
    // Without Cloud Functions the actor's own client writes the row, so the
    // rules have to do the work a server would: you may tell someone what you
    // did, in your own name, and nothing else.

    match /notifications/{id} {
      allow read: if isSignedIn()
        && request.auth.uid == resource.data.recipientUid;

      allow create: if isSignedIn()
        // In your own name only — otherwise anyone could forge a notification
        // from anyone.
        && request.resource.data.actorUid == request.auth.uid
        // Never to yourself, so the badge cannot be self-inflated.
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.kind is string;

      // The recipient marks it read. Nothing else about it may change — not
      // who did it, not when, not what it was.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.recipientUid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['read']);

      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.recipientUid;
    }

    // --- Profile views ------------------------------------------------------

    match /profileViews/{view} {
      // Only the person being looked at may read their visitor list. A public
      // record of who is watching whom is a different and much worse product.
      allow read: if isSignedIn() && request.auth.uid == resource.data.profileUid;

      // A visit is recorded as the viewer, about someone else.
      allow create, update: if isSignedIn()
        && request.resource.data.viewerUid == request.auth.uid
        && request.resource.data.profileUid != request.auth.uid;

      allow delete: if false;
    }

    // --- Messaging ----------------------------------------------------------
    //
    // A conversation shares its id with the connection between the same two
    // people ("alice-bob", usernames sorted), so one lookup answers "may these
    // two talk?". Only an accepted connection opens one, and messages can only
    // be sent while it stays accepted — removing the connection keeps the
    // history and closes the conversation.
    //
    // Accepted, not merely requested. A request is one person asking; letting
    // it open a conversation would let anyone message anyone by sending a
    // request first, which is what the accept step exists to prevent.
    //
    // Ticks are not stored per message. Each chat holds two timestamps per
    // person: when their app last received the conversation (deliveredAt) and
    // when they last had it open (readAt). A message is delivered or read if
    // it was sent before the other person's mark. That is one small write per
    // person per catch-up instead of one per message, which is what keeps
    // this inside the free tier. It also means the marks are the thing to
    // protect: you may move your own marks to now and never anyone else's —
    // otherwise a client could make its messages look read.

    // "Typing": one timestamp per person, set to now while they type and
    // removed when they send or clear the box. Like the other marks, only
    // your own can move, and only to the server's clock.
    function typingOk(o, n, me, other) {
      return n.typing is map
        && n.typing.keys().hasOnly(o.uids)
        && n.typing.get(other, null) == o.get('typing', {}).get(other, null)
        && (n.typing.get(me, null) == o.get('typing', {}).get(me, null)
            || n.typing.get(me, null) == request.time
            || n.typing.get(me, null) == null);
    }

    function chatUpdateOk(chatId) {
      let o = resource.data;
      let n = request.resource.data;
      let me = request.auth.uid;
      let other = o.uids[0] == me ? o.uids[1] : o.uids[0];
      return me in o.uids
        && n.uids == o.uids
        && n.users == o.users
        && n.createdAt == o.createdAt
        && n.diff(o).affectedKeys()
             .hasOnly(['lastMessage', 'updatedAt', 'unread', 'readAt', 'deliveredAt', 'typing'])
        && n.unread.keys().hasOnly(o.uids)
        && n.readAt.keys().hasOnly(o.uids)
        && n.deliveredAt.keys().hasOnly(o.uids)
        // Their marks never move; mine only ever move to now.
        && n.readAt[other] == o.readAt[other]
        && n.deliveredAt[other] == o.deliveredAt[other]
        && (n.readAt[me] == o.readAt[me] || n.readAt[me] == request.time)
        && (n.deliveredAt[me] == o.deliveredAt[me] || n.deliveredAt[me] == request.time)
        // My count may be cleared, or set to one to mark the chat unread.
        // Theirs may only rise by one, which is what sending a message does.
        && (n.unread[me] == o.unread[me] || n.unread[me] == 0 || n.unread[me] == 1)
        && (n.unread[other] == o.unread[other] || n.unread[other] == o.unread[other] + 1)
        && (n.updatedAt == o.updatedAt || n.updatedAt == request.time)
        && (n.get('typing', null) == o.get('typing', null) || typingOk(o, n, me, other))
        // A new preview must be mine and must say exactly what the message
        // it points at says — no preview can claim a message that is not there.
        && (n.lastMessage == o.lastMessage
            || (n.lastMessage.senderUid == me
                && n.lastMessage.text == getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(n.lastMessage.id)).data.text
                && n.lastMessage.unsent == getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(n.lastMessage.id)).data.unsent));
    }

    // Something shared into a conversation: a feed post, or your place on the
    // leaderboard. A post has to exist and be by the person named — so a
    // card can never pin a post on the wrong author. A rank has the same
    // shape a rank post in the feed must have.
    function attachmentOk(a) {
      return a is map && (
        (a.keys().hasOnly(['type', 'postId', 'authorUid'])
          && a.keys().hasAll(['type', 'postId', 'authorUid'])
          && a.type == 'post'
          && get(/databases/$(database)/documents/posts/$(a.postId)).data.authorUid == a.authorUid)
        || (a.keys().hasOnly(['type', 'rank', 'score'])
          && a.keys().hasAll(['type', 'rank', 'score'])
          && a.type == 'rank'
          && a.rank is int && a.rank > 0
          && a.score is number && a.score >= 0 && a.score <= 100)
        // An invitation: a community that exists.
        || (a.keys().hasOnly(['type', 'communityId'])
          && a.keys().hasAll(['type', 'communityId'])
          && a.type == 'community'
          && exists(communityPath(a.communityId)))
        // A poll: a question and two to four answers.
        || (a.keys().hasOnly(['type', 'question', 'options'])
          && a.keys().hasAll(['type', 'question', 'options'])
          && a.type == 'poll'
          && pollOk(a))
        // A closed trade, as its owner's journal has it.
        || (a.keys().hasOnly(tradeCardKeys())
          && a.keys().hasAll(tradeCardKeys())
          && a.type == 'trade'
          && tradeCardOk(a)));
    }

    function tradeCardKeys() {
      return ['type', 'ownerUid', 'tradeId', 'symbol', 'direction', 'entryPrice',
              'stopPrice', 'targetPrice', 'exitPrice', 'exitReason', 'r'];
    }

    /// A trade card says what the trade says: the same pair, side and
    /// prices, closed, and a result in R close to what its prices made — the
    /// spread takes a little away, and a swap paid in can add a little back,
    /// never a whole R. So a loss is never sent as a win, nor a small win as
    /// a big one, by its owner or by anyone forwarding it.
    function tradeCardOk(a) {
      let t = get(/databases/$(database)/documents/users/$(a.ownerUid)/trades/$(a.tradeId)).data;
      let sign = t.direction == 'buy' ? 1 : -1;
      let gross = (t.exitPrice - t.entryPrice) * sign / math.abs(t.entryPrice - t.stopPrice);
      return a.ownerUid is string
        && a.tradeId is string
        && t.symbol == a.symbol
        && t.direction == a.direction
        && t.entryPrice == a.entryPrice
        && t.stopPrice == a.stopPrice
        && t.targetPrice == a.targetPrice
        && t.exitPrice is number
        && t.exitPrice == a.exitPrice
        && t.exitReason == a.exitReason
        && a.r is number
        && a.r < gross + 1
        && a.r > gross - 3;
    }

    function pollOptionOk(o) {
      return o is string && o.size() > 0 && o.size() <= 40;
    }

    function pollOk(a) {
      return a.question is string
        && a.question.size() > 0
        && a.question.size() <= 140
        && a.options is list
        && a.options.size() >= 2
        && a.options.size() <= 4
        && pollOptionOk(a.options[0])
        && pollOptionOk(a.options[1])
        && (a.options.size() < 3 || pollOptionOk(a.options[2]))
        && (a.options.size() < 4 || pollOptionOk(a.options[3]));
    }

    /// A vote on a poll: one each, only your own, for an answer it has —
    /// and none on a poll that has been unsent.
    function voteOk() {
      let before = resource.data.get('votes', {});
      let after = request.resource.data.get('votes', {});
      return resource.data.unsent == false
        && resource.data.get('attachment', {}).get('type', '') == 'poll'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && after is map
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in after)
            || (after[request.auth.uid] is int
                && after[request.auth.uid] >= 0
                && after[request.auth.uid] < resource.data.attachment.options.size()));
    }

    // A message has words, or something shared, or both.
    function messageBodyOk(m) {
      return m.text is string
        && m.text.size() <= 2000
        && (m.text.size() > 0 || 'attachment' in m)
        && (!('attachment' in m) || attachmentOk(m.attachment));
    }

    // A reply names the message it answers. It has to be a real message in
    // the same conversation, by the person it says — so no reply can put
    // words in anyone's mouth. The text is not copied: the app shows the
    // original, so unsending it also removes it from every reply.
    function replyOk(chatId, r) {
      return r is map
        && r.keys().hasOnly(['id', 'senderUid'])
        && r.keys().hasAll(['id', 'senderUid'])
        && get(/databases/$(database)/documents/chats/$(chatId)/messages/$(r.id)).data.senderUid == r.senderUid;
    }

    match /chats/{chatId} {
      // A missing chat is a normal answer — it is how the app knows to open
      // one — so get is allowed on nothing, like connections.
      allow get: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.uids);
      allow list: if isSignedIn() && request.auth.uid in resource.data.uids;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
             ['uids', 'users', 'createdAt', 'updatedAt', 'lastMessage', 'unread', 'readAt', 'deliveredAt'])
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids.size() == 2
        && request.resource.data.users.size() == 2
        && chatId == request.resource.data.users[0] + '-' + request.resource.data.users[1]
        // The same two people as the connection, and the connection is
        // accepted — before this write, or by the acceptance in the same
        // batch, which is how the app opens it.
        && existsAfter(/databases/$(database)/documents/connections/$(chatId))
        && getAfter(/databases/$(database)/documents/connections/$(chatId)).data.accepted == true
        && getAfter(/databases/$(database)/documents/connections/$(chatId)).data.users == request.resource.data.users
        && getAfter(/databases/$(database)/documents/connections/$(chatId)).data.uids.hasAll(request.resource.data.uids)
        && request.resource.data.lastMessage == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.unread[request.resource.data.uids[0]] == 0
        && request.resource.data.unread[request.resource.data.uids[1]] == 0
        && request.resource.data.readAt[request.resource.data.uids[0]] == request.time
        && request.resource.data.readAt[request.resource.data.uids[1]] == request.time
        && request.resource.data.deliveredAt[request.resource.data.uids[0]] == request.time
        && request.resource.data.deliveredAt[request.resource.data.uids[1]] == request.time;

      allow update: if isSignedIn() && chatUpdateOk(chatId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.uids;

        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.uids
          && request.resource.data.keys()
               .hasOnly(['senderUid', 'text', 'sentAt', 'unsent', 'replyTo', 'forwarded', 'attachment'])
          && (!('replyTo' in request.resource.data)
              || replyOk(chatId, request.resource.data.replyTo))
          // Only ever true: it marks a copy of a message from another chat.
          && (!('forwarded' in request.resource.data)
              || request.resource.data.forwarded == true)
          && request.resource.data.senderUid == request.auth.uid
          && messageBodyOk(request.resource.data)
          // Polls are for rooms, where there are people to ask.
          && request.resource.data.get('attachment', {}).get('type', '') != 'poll'
          && request.resource.data.sentAt == request.time
          && request.resource.data.unsent == false
          // Still connected. Removing the connection closes the conversation.
          && get(/databases/$(database)/documents/connections/$(chatId)).data.accepted == true
          // And neither of them has blocked the other.
          && !blockedEitherWay(
               get(/databases/$(database)/documents/chats/$(chatId)).data.uids[0],
               get(/databases/$(database)/documents/chats/$(chatId)).data.uids[1]);

        // Unsending blanks the text and flags it; the message keeps its place
        // so the conversation still makes sense around it. Only the sender.
        // Either of them may react, while neither has blocked the other.
        allow update: if isSignedIn()
          && ((resource.data.senderUid == request.auth.uid
               && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['text', 'unsent', 'attachment'])
               // What was shared goes with the words.
               && !('attachment' in request.resource.data)
               && request.resource.data.unsent == true
               && request.resource.data.text == '')
              || (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.uids
                  && reactionOk()
                  && !blockedEitherWay(
                       get(/databases/$(database)/documents/chats/$(chatId)).data.uids[0],
                       get(/databases/$(database)/documents/chats/$(chatId)).data.uids[1])));

        allow delete: if false;
      }
    }

    // --- Rooms --------------------------------------------------------------
    //
    // A conversation for everyone. There is one, "global", made by hand;
    // nobody can make another or delete it. Anyone signed in can read it —
    // that is how you decide to join — and only members can write in it.
    // Joining is what brings unread counts and banners; leaving ends them.
    //
    // Who sent a message is written onto it, because a room has too many
    // people to look each one up. So the name has to be the sender's real
    // one: nobody can post as someone else.

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    // Global is everyone's; a community's room is its members'.
    function canUseRoom(roomId) {
      return roomId == 'global' || roomId == 'c_' + myCommunity();
    }

    // The same, as it will be once this write lands — for joining.
    function canJoinRoom(roomId) {
      return roomId == 'global'
        || roomId == 'c_' + getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data
             .get('communityId', '');
    }

    function isMember(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    // The preview moves with a message just written by the same person —
    // or with their own unsend — and says exactly what the message says.
    function roomPreviewOk(roomId) {
      let o = resource.data;
      let n = request.resource.data;
      let msg = getAfter(/databases/$(database)/documents/rooms/$(roomId)/messages/$(n.lastMessage.id)).data;
      return n.diff(o).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
        && n.lastMessage.keys().hasOnly(['id', 'senderUid', 'senderName', 'text', 'unsent', 'attachmentType'])
        && n.lastMessage.get('attachmentType', null) == msg.get('attachment', {}).get('type', null)
        && n.lastMessage.senderUid == request.auth.uid
        && msg.senderUid == request.auth.uid
        && n.lastMessage.senderName == msg.senderName
        && n.lastMessage.text == msg.text
        && n.lastMessage.unsent == msg.unsent
        && (msg.sentAt == request.time || msg.unsent == true)
        && (n.updatedAt == o.updatedAt || n.updatedAt == request.time);
    }

    // The member count moves by one, and only with your own joining or
    // leaving in the same write.
    function roomCountOk(roomId) {
      let o = resource.data;
      let n = request.resource.data;
      let member = /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid);
      return n.diff(o).affectedKeys().hasOnly(['memberCount'])
        && ((n.memberCount == o.memberCount + 1 && !exists(member) && existsAfter(member))
            || (n.memberCount == o.memberCount - 1 && exists(member) && !existsAfter(member)));
    }

    function roomReplyOk(roomId, r) {
      return r is map
        && r.keys().hasOnly(['id', 'senderUid'])
        && r.keys().hasAll(['id', 'senderUid'])
        && get(/databases/$(database)/documents/rooms/$(roomId)/messages/$(r.id)).data.senderUid == r.senderUid;
    }

    function roomMessagePath(roomId, id) {
      return /databases/$(database)/documents/rooms/$(roomId)/messages/$(id);
    }

    // A community's admin pins one message for everyone, or takes the pin
    // down. And whoever unsends the pinned message takes the pin down with
    // it, so a pin never shows words that are gone.
    function roomPinOk(roomId) {
      let o = resource.data;
      let n = request.resource.data;
      return n.diff(o).affectedKeys().hasOnly(['pinned'])
        && (((isRoomAdmin(roomId) || isRoomModerator(roomId))
             && (n.pinned == null || pinOk(roomId, n.pinned)))
            || (n.pinned == null
                && o.get('pinned', null) != null
                && getAfter(roomMessagePath(roomId, o.pinned.id)).data.unsent == true));
    }

    // The pin says exactly what the message says.
    function pinOk(roomId, p) {
      let msg = get(roomMessagePath(roomId, p.id)).data;
      return p is map
        && p.keys().hasOnly(['id', 'senderUid', 'senderName', 'text'])
        && p.keys().hasAll(['id', 'senderUid', 'senderName', 'text'])
        && msg.unsent == false
        && p.text is string
        && p.text.size() > 0
        && p.text == msg.text
        && p.senderUid == msg.senderUid
        && p.senderName == msg.senderName;
    }

    /// Whether the person asking is the admin of the community a room
    /// belongs to. Global has none.
    function isRoomAdmin(roomId) {
      return roomId != 'global'
        && get(communityPath(roomId.split('_')[1])).data.createdBy == request.auth.uid;
    }

    /// Whether the person asking is one of the moderators its admin picked
    /// to help keep a community's room.
    function isRoomModerator(roomId) {
      return roomId != 'global'
        && exists(memberPath(roomId.split('_')[1], request.auth.uid))
        && get(memberPath(roomId.split('_')[1], request.auth.uid)).data.role == 'moderator';
    }

    /// Who may take down a message by [senderUid]: the admin, anyone's; a
    /// moderator, anyone's but the admin's.
    function canRemove(roomId, senderUid) {
      return isRoomAdmin(roomId)
        || (isRoomModerator(roomId)
            && senderUid != get(communityPath(roomId.split('_')[1])).data.createdBy);
    }

    // The admin took the newest message down: the preview says so, and
    // nothing else about it changes.
    function roomRemovalPreviewOk(roomId) {
      let o = resource.data;
      let n = request.resource.data;
      return (isRoomAdmin(roomId) || isRoomModerator(roomId))
        && n.diff(o).affectedKeys().hasOnly(['lastMessage'])
        && o.lastMessage.id == n.lastMessage.id
        && n.lastMessage.keys().hasOnly(['id', 'senderUid', 'senderName', 'text', 'unsent'])
        && n.lastMessage.senderUid == o.lastMessage.senderUid
        && n.lastMessage.senderName == o.lastMessage.senderName
        && n.lastMessage.text == ''
        && n.lastMessage.unsent == true
        && getAfter(roomMessagePath(roomId, n.lastMessage.id)).data.get('removed', false) == true;
    }

    // Slow mode, in a community's room: each member writes at most once per
    // the admin's interval — their own mark moves with every message they
    // send. The admin is never slowed.
    function slowModeOk(roomId) {
      return roomId == 'global' || communitySlowModeOk(roomId);
    }

    function communitySlowModeOk(roomId) {
      let c = get(communityPath(roomId.split('_')[1])).data;
      let slow = c.get('slowSeconds', 0);
      let mine = /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid);
      return slow == 0
        || c.createdBy == request.auth.uid
        || (getAfter(mine).data.get('lastSentAt', null) == request.time
            && request.time > get(mine).data.get('lastSentAt', timestamp.value(0))
                 + duration.value(slow, 's'));
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn() && (canUseRoom(roomId) || isAdmin());
      allow delete: if false;

      // A community's room, made with the community, by its founder.
      allow create: if isSignedIn()
        && roomId.matches('c_[A-Za-z0-9]{6,40}')
        && request.resource.data.keys()
             .hasOnly(['name', 'community', 'memberCount', 'lastMessage', 'createdAt', 'updatedAt'])
        && request.resource.data.community == roomId.split('_')[1]
        && !exists(communityPath(request.resource.data.community))
        && getAfter(communityPath(request.resource.data.community)).data.createdBy == request.auth.uid
        && request.resource.data.name == getAfter(communityPath(request.resource.data.community)).data.name
        && request.resource.data.memberCount == 1
        && request.resource.data.lastMessage == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isSignedIn()
        && (roomPreviewOk(roomId) || roomCountOk(roomId) || roomPinOk(roomId)
            || roomRemovalPreviewOk(roomId));

      // Your membership, and how far you have read. Nobody else's business.
      match /members/{uid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && canJoinRoom(roomId)
          && request.resource.data.keys().hasOnly(['joinedAt', 'readAt'])
          && request.resource.data.joinedAt == request.time
          && request.resource.data.readAt == request.time
          // Counted in: the first member of a room made in this same write,
          // or one more than there were.
          && ((!exists(roomPath(roomId)) && getAfter(roomPath(roomId)).data.memberCount == 1)
              || (exists(roomPath(roomId))
                  && getAfter(roomPath(roomId)).data.memberCount
                       == get(roomPath(roomId)).data.memberCount + 1));
        // Reading moves the read mark; writing moves the sent mark too.
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['readAt', 'lastSentAt'])
          && request.resource.data.readAt == request.time
          && (unchanged('lastSentAt') || request.resource.data.lastSentAt == request.time);
        allow delete: if isOwner(uid)
          && getAfter(roomPath(roomId)).data.memberCount == get(roomPath(roomId)).data.memberCount - 1;
      }

      match /messages/{messageId} {
        allow read: if isSignedIn() && (canUseRoom(roomId) || isAdmin());
        allow create: if isSignedIn()
          && isMember(roomId)
          && canUseRoom(roomId)
          // A locked community's room: only its admin writes.
          && (roomId == 'global' || communityOpenTo(roomId.split('_')[1]))
          && slowModeOk(roomId)
          && request.resource.data.keys().hasOnly([
               'senderUid', 'senderName', 'senderUsername', 'text', 'sentAt', 'unsent',
               'replyTo', 'forwarded', 'attachment'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderUsername
               == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
          && request.resource.data.senderName
               == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && messageBodyOk(request.resource.data)
          && wordsOk(request.resource.data.get('text', ''))
          && request.resource.data.sentAt == request.time
          && request.resource.data.unsent == false
          && (!('replyTo' in request.resource.data)
              || roomReplyOk(roomId, request.resource.data.replyTo))
          && (!('forwarded' in request.resource.data)
              || request.resource.data.forwarded == true);

        // Unsending: the sender blanks their own, as in a chat. Removing:
        // a community's admin blanks anyone's, and a moderator anyone's but
        // the admin's, marked as removed. Reacting and voting: any member,
        // where they could write.
        allow update: if isSignedIn()
          && ((resource.data.senderUid == request.auth.uid
               && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['text', 'unsent', 'attachment'])
               // What was shared goes with the words.
               && !('attachment' in request.resource.data)
               && request.resource.data.unsent == true
               && request.resource.data.text == '')
              || (canRemove(roomId, resource.data.senderUid)
                  && resource.data.unsent == false
                  && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['text', 'unsent', 'attachment', 'removed'])
                  && !('attachment' in request.resource.data)
                  && request.resource.data.unsent == true
                  && request.resource.data.text == ''
                  && request.resource.data.removed == true)
              || (isMember(roomId)
                  && canUseRoom(roomId)
                  && (roomId == 'global' || communityOpenTo(roomId.split('_')[1]))
                  && (reactionOk() || voteOk())));
        allow delete: if false;
      }
    }

    // --- Communities ----------------------------------------------------------
    //
    // Anyone can start one, and anyone can join any of them — no approval —
    // but each person is in one at a time. Starting one makes you its admin
    // and makes its chat room, in the same write. The name is claimed like a
    // username, so no two communities share one.

    // The member count moves by one, with your own joining or leaving.
    function communityCountOk(cid) {
      let o = resource.data;
      let n = request.resource.data;
      let member = /databases/$(database)/documents/communities/$(cid)/members/$(request.auth.uid);
      return n.diff(o).affectedKeys().hasOnly(['memberCount'])
        && ((n.memberCount == o.memberCount + 1 && !exists(member) && existsAfter(member))
            || (n.memberCount == o.memberCount - 1 && exists(member) && !existsAfter(member)));
    }

    // One of the pictures in app/lib/data/community_avatars.dart.
    function communityAvatarOk(c) {
      return c.avatarId is int && c.avatarId >= 1 && c.avatarId <= 28;
    }

    function memberPath(cid, uid) {
      return /databases/$(database)/documents/communities/$(cid)/members/$(uid);
    }

    // A community's rules, as its admin writes them: up to five, each a
    // line of up to 120 letters.
    function ruleLineOk(r) {
      return r is string && r.size() > 0 && r.size() <= 120;
    }

    function communityRulesOk(c) {
      let rules = c.get('rules', []);
      return rules is list
        && rules.size() <= 5
        && (rules.size() < 1 || ruleLineOk(rules[0]))
        && (rules.size() < 2 || ruleLineOk(rules[1]))
        && (rules.size() < 3 || ruleLineOk(rules[2]))
        && (rules.size() < 4 || ruleLineOk(rules[3]))
        && (rules.size() < 5 || ruleLineOk(rules[4]));
    }

    // A community's moderators, listed on it: three at most, each one a
    // moderator in the members — and anyone taken off the list no longer
    // one. So the list is every moderator there is, and three is the limit.
    function isModeratorAfter(cid, uid) {
      return existsAfter(memberPath(cid, uid))
        && getAfter(memberPath(cid, uid)).data.role == 'moderator';
    }

    function moderatorsOk(cid) {
      let after = request.resource.data.get('moderators', []);
      let before = resource.data.get('moderators', []);
      return after is list
        && after.size() <= 3
        && (after.size() < 1 || isModeratorAfter(cid, after[0]))
        && (after.size() < 2 || isModeratorAfter(cid, after[1]))
        && (after.size() < 3 || isModeratorAfter(cid, after[2]))
        && (before.size() < 1 || before[0] in after || !isModeratorAfter(cid, before[0]))
        && (before.size() < 2 || before[1] in after || !isModeratorAfter(cid, before[1]))
        && (before.size() < 3 || before[2] in after || !isModeratorAfter(cid, before[2]));
    }

    // A community changing hands: to someone already in it, with both
    // memberships saying so in the same write.
    function handOverOk(cid, from, to) {
      return to != from
        && exists(memberPath(cid, to))
        && getAfter(memberPath(cid, to)).data.role == 'admin'
        && getAfter(memberPath(cid, from)).data.role == 'member';
    }

    match /communities/{cid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && cid.matches('[A-Za-z0-9]{6,40}')
        && request.resource.data.keys()
             .hasOnly(['name', 'nameLower', 'description', 'avatarId', 'createdBy', 'createdAt', 'memberCount'])
        && request.resource.data.createdBy == request.auth.uid
        && communityAvatarOk(request.resource.data)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 60
        && request.resource.data.name == request.resource.data.name.trim()
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 200
        && request.resource.data.createdAt == request.time
        && request.resource.data.memberCount == 1
        && getAfter(/databases/$(database)/documents/communityNames/$(request.resource.data.nameLower)).data.communityId == cid
        && getAfter(/databases/$(database)/documents/communities/$(cid)/members/$(request.auth.uid)).data.role == 'admin'
        && existsAfter(/databases/$(database)/documents/rooms/$('c_' + cid));
      // Joining and leaving count; the admin may change the description, the
      // picture and the rules, lock it — no one joins a locked community, and only its
      // admin writes in it — and hand it to another member. Deleting it, or
      // removing someone, goes through the worker, which can clear the
      // profiles of everyone in it.
      allow update: if isSignedIn()
        && (communityCountOk(cid)
            || (resource.data.createdBy == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['description', 'avatarId', 'locked', 'createdBy', 'slowSeconds', 'rules',
                               'moderators'])
                && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderators'])
                    || moderatorsOk(cid))
                && request.resource.data.get('slowSeconds', 0) in [0, 10, 30, 60, 300]
                && communityRulesOk(request.resource.data)
                && request.resource.data.description is string
                && request.resource.data.description.size() <= 200
                && communityAvatarOk(request.resource.data)
                && request.resource.data.get('locked', false) is bool
                && (request.resource.data.createdBy == resource.data.createdBy
                    || handOverOk(cid, resource.data.createdBy,
                                  request.resource.data.createdBy))));
      allow delete: if false;

      // Its events: the admin plans them, members say they are going. For
      // its members to see, like its feed and its chat.
      match /events/{eventId} {
        allow read: if isSignedIn() && (myCommunity() == cid || isAdmin());
        allow create: if isSignedIn()
          && get(communityPath(cid)).data.createdBy == request.auth.uid
          && request.resource.data.keys()
               .hasOnly(['title', 'description', 'startsAt', 'createdBy', 'createdAt', 'going'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 3
          && request.resource.data.title.size() <= 80
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 300
          && request.resource.data.startsAt is timestamp
          && request.resource.data.startsAt > request.time
          && request.resource.data.createdAt == request.time
          && request.resource.data.going == [];
        // Going, or not: your own uid in the list, or out of it.
        allow update: if isSignedIn()
          && myCommunity() == cid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['going'])
          && request.resource.data.going is list
          && request.resource.data.going.size() == request.resource.data.going.toSet().size()
          && ((!(request.auth.uid in resource.data.going)
               && request.resource.data.going.toSet()
                    == resource.data.going.toSet().union([request.auth.uid].toSet()))
              || (request.auth.uid in resource.data.going
               && request.resource.data.going.toSet()
                    == resource.data.going.toSet().difference([request.auth.uid].toSet())));
        allow delete: if isSignedIn()
          && get(communityPath(cid)).data.createdBy == request.auth.uid;
      }

      // Who is in it. Public, like connections: a community's members are
      // what a community is.
      match /members/{uid} {
        allow read: if isSignedIn();
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['role', 'joinedAt', 'username'])
          && request.resource.data.joinedAt == request.time
          && request.resource.data.username
               == get(/databases/$(database)/documents/users/$(uid)).data.username
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.get('communityId', '') == cid
          && (
            // The founder, as the community is made.
            (request.resource.data.role == 'admin'
              && !exists(communityPath(cid))
              && getAfter(communityPath(cid)).data.createdBy == uid)
            // Anyone else, counted in — unless it is locked.
            || (request.resource.data.role == 'member'
              && exists(communityPath(cid))
              && get(communityPath(cid)).data.get('locked', false) != true
              && getAfter(communityPath(cid)).data.memberCount
                   == get(communityPath(cid)).data.memberCount + 1));
        // A role is the admin's to give: admin for the one the community is
        // handed to; moderator, or member, for anyone else.
        allow update: if isSignedIn()
          && get(communityPath(cid)).data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && ((getAfter(communityPath(cid)).data.createdBy == uid
               && request.resource.data.role == 'admin')
              || (getAfter(communityPath(cid)).data.createdBy != uid
               && request.resource.data.role in ['member', 'moderator']
               // A moderator only as one of the community's listed few.
               && (request.resource.data.role != 'moderator'
                   || uid in getAfter(communityPath(cid)).data.get('moderators', []))));
        // Leaving: counted out, and no longer your community. Not for its
        // admin, who deletes it instead — a community is never left without
        // one.
        allow delete: if isOwner(uid)
          && get(communityPath(cid)).data.createdBy != uid
          && getAfter(/databases/$(database)/documents/users/$(uid)).data.get('communityId', '') != cid
          && getAfter(communityPath(cid)).data.memberCount
               == get(communityPath(cid)).data.memberCount - 1;
      }
    }

    // Each month's champion: the community on top when the month turned,
    // crowned by the worker (worker/src/champion.js). Read by everyone.
    match /champions/{month} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // One claim per name, like usernames, so no two communities share one.
    match /communityNames/{name} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['communityId'])
        && !exists(communityPath(request.resource.data.communityId))
        && getAfter(communityPath(request.resource.data.communityId)).data.nameLower == name
        && getAfter(communityPath(request.resource.data.communityId)).data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    // --- Reports ------------------------------------------------------------
    //
    // Write-only for everyone. A report is read by the people who moderate
    // the app, in the console — never by the person it is about, and not
    // even by the person who filed it, so a report cannot be used to find
    // out anything.
    //
    // Evidence has to be real. A report about a message must come from
    // someone in that conversation and quote the message exactly as it is
    // stored; a report about a post must quote the post. Nobody can file a
    // report with words put in someone else's mouth.
    function reportEvidenceOk(r) {
      return (r.kind == 'user')
        // A message in a room — Global, or a community's: anyone who can
        // read it can report it, as long as the quote is what it says.
        || (r.kind == 'message' && r.chatId.matches('global|c_[A-Za-z0-9]+')
            && canUseRoom(r.chatId)
            && get(/databases/$(database)/documents/rooms/$(r.chatId)/messages/$(r.messageId)).data.senderUid == r.targetUid
            && get(/databases/$(database)/documents/rooms/$(r.chatId)/messages/$(r.messageId)).data.text == r.quote)
        || (r.kind == 'message' && !r.chatId.matches('global|c_[A-Za-z0-9]+')
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(r.chatId)).data.uids
            && get(/databases/$(database)/documents/chats/$(r.chatId)/messages/$(r.messageId)).data.senderUid == r.targetUid
            && get(/databases/$(database)/documents/chats/$(r.chatId)/messages/$(r.messageId)).data.text == r.quote)
        || (r.kind == 'post'
            && get(/databases/$(database)/documents/posts/$(r.postId)).data.authorUid == r.targetUid
            && get(/databases/$(database)/documents/posts/$(r.postId)).data.lesson == r.quote)
        || (r.kind == 'comment'
            && get(/databases/$(database)/documents/posts/$(r.postId)/comments/$(r.commentId)).data.authorUid == r.targetUid
            && get(/databases/$(database)/documents/posts/$(r.postId)/comments/$(r.commentId)).data.body == r.quote);
    }

    match /reports/{reportId} {
      // Read by the admins who act on them; changed only by the worker.
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
             'reporterUid', 'kind', 'targetUid', 'targetUsername', 'reason', 'note',
             'quote', 'chatId', 'messageId', 'postId', 'commentId', 'createdAt', 'status'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.targetUsername is string
        && request.resource.data.kind in ['user', 'message', 'post', 'comment']
        && request.resource.data.reason in
             ['spam', 'harassment', 'hate', 'sexual', 'violence', 'scam', 'impersonation', 'other']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open'
        && reportEvidenceOk(request.resource.data);
    }

    // --- Presence -----------------------------------------------------------
    //
    // One timestamp per person, refreshed while the app is open. Firestore
    // cannot notice a dropped connection the way the Realtime Database can,
    // so "active now" means "seen in the last couple of minutes", and the
    // only value anyone may write is the server's own clock.
    match /presence/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['lastActiveAt'])
        && request.resource.data.lastActiveAt == request.time;
      allow delete: if false;
    }

    // --- Weekly challenges --------------------------------------------------
    //
    // Two connections, one week: whose discipline score is higher by Sunday
    // midnight. The scores are the worker's (weekScore, lastWeekScore); the
    // challenge only says who, and which week. `{week}_{connection}`, so one
    // a week between any two.
    match /challenges/{id} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.uids;
      allow create: if isSignedIn()
        && request.resource.data.keys()
             .hasOnly(['fromUid', 'toUid', 'uids', 'pair', 'week', 'createdAt', 'accepted'])
        && request.resource.data.keys()
             .hasAll(['fromUid', 'toUid', 'uids', 'pair', 'week', 'createdAt', 'accepted'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.uids
             == [request.resource.data.fromUid, request.resource.data.toUid]
        && request.resource.data.week is string
        && request.resource.data.week.matches('^[0-9]{4}-W[0-9]{2}$')
        && id == request.resource.data.week + '_' + request.resource.data.pair
        && request.resource.data.createdAt == request.time
        && request.resource.data.accepted == false
        // Connected: the two of them, accepted.
        && get(/databases/$(database)/documents/connections/$(request.resource.data.pair)).data.accepted == true
        && get(/databases/$(database)/documents/connections/$(request.resource.data.pair)).data.uids
             .hasAll([request.auth.uid, request.resource.data.toUid])
        && !blockedEitherWay(request.auth.uid, request.resource.data.toUid);
      // Accepted by the one challenged; nothing else changes.
      allow update: if isSignedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepted'])
        && request.resource.data.accepted == true;
      // Declined, or called off, by either.
      allow delete: if isSignedIn() && request.auth.uid in resource.data.uids;
    }

    // --- Market mood --------------------------------------------------------
    //
    // Each day, for each pair, who thinks it goes up and who down: everyone's,
    // or one community's own — `{scope}_{pair}_{day}`, the scope 'global' or
    // the community's id. One side each, your own uid only, today's only.
    // The pairs are the app's (app/lib/models/instrument.dart).

    /// Today's date in Dhaka, as the app writes it: 20261002.
    function dhakaDay() {
      let t = request.time + duration.value(6, 'h');
      return string(t.year())
        + (t.month() < 10 ? '0' : '') + string(t.month())
        + (t.day() < 10 ? '0' : '') + string(t.day());
    }

    function moodScopeOk(scope) {
      return scope == 'global' || myCommunity() == scope;
    }

    function noRepeats(l) {
      return l is list && l.size() == l.toSet().size();
    }

    /// The list [field] the same but for the person asking.
    function othersUnchanged(field) {
      return request.resource.data[field].toSet().difference([request.auth.uid].toSet())
        == resource.data[field].toSet().difference([request.auth.uid].toSet());
    }

    match /sentiment/{id} {
      // By the id, so a day nobody has voted on yet can be watched too.
      allow read: if isSignedIn() && moodScopeOk(id.split('_')[0]);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['scope', 'pair', 'day', 'bulls', 'bears'])
        && request.resource.data.keys().hasAll(['scope', 'pair', 'day', 'bulls', 'bears'])
        && id == request.resource.data.scope + '_' + request.resource.data.pair
                 + '_' + request.resource.data.day
        && request.resource.data.pair in ['EURUSD', 'GBPUSD', 'USDJPY']
        && request.resource.data.day == dhakaDay()
        && moodScopeOk(request.resource.data.scope)
        && ((request.resource.data.bulls == [request.auth.uid]
             && request.resource.data.bears == [])
            || (request.resource.data.bulls == []
             && request.resource.data.bears == [request.auth.uid]));
      allow update: if isSignedIn()
        && moodScopeOk(resource.data.scope)
        && resource.data.day == dhakaDay()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bulls', 'bears'])
        && noRepeats(request.resource.data.bulls)
        && noRepeats(request.resource.data.bears)
        && othersUnchanged('bulls')
        && othersUnchanged('bears')
        && !(request.auth.uid in request.resource.data.bulls
             && request.auth.uid in request.resource.data.bears);
      allow delete: if false;
    }

    // --- Admins -------------------------------------------------------------
    //
    // Who runs the app. Written only by the server (tool/make_admin.py, or
    // the worker for an admin in the panel); each person may see their own
    // entry, which is how the panel lets them in, and admins see them all.
    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // What the admins announced to every phone, kept by the worker when it
    // sends one (worker/src/admin.js). For the admin panel only.
    match /announcements/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The app's settings, as the admins set them in the panel and the worker
    // writes them: config/app (maintenance, the oldest build allowed, a
    // banner, the post pinned to Global) and config/moderation (the blocked
    // words). Readable by everyone — the app checks for maintenance before
    // anyone has signed in.
    match /config/{id} {
      allow read: if true;
      allow write: if false;
    }

    // People locked out asking for a new password, with how to reach them
    // (worker/src/help.js). Only owners and admins, who can set one, see them.
    match /helpRequests/{id} {
      allow read: if isFullAdmin();
      allow write: if false;
    }

    // Each day's numbers — accounts, who used the app, posts, trades —
    // counted by the worker every morning (worker/src/snapshot.js). For the
    // admin panel's growth chart.
    match /stats/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Announcements waiting for their time, sent by the worker's quarter-hour
    // run (worker/src/admin-cron.js). For the admin panel only.
    match /scheduled/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Every change an admin made, written by the worker as it makes it: who,
    // what, to whom, when. Nobody edits the record, admins included.
    match /adminLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // --- Lessons ------------------------------------------------------------
    //
    // Course content, published from the repo. Read-only to everyone.
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
