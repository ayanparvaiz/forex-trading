{
  "comment": [
    "Composite indexes only. Firestore creates single-field indexes on its own",
    "and rejects any attempt to declare one, so a query ordered by a single",
    "field needs no entry here."
  ],
  "indexes": [
    {
      "comment": "Leaderboard reads profiles directly: discipline first, trade count as the tiebreak.",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "disciplineScore",
          "order": "DESCENDING"
        },
        {
          "fieldPath": "tradeCount",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "The live leaderboard: ranked accounts only, discipline first, trade count as the tiebreak.",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "ranked",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "disciplineScore",
          "order": "DESCENDING"
        },
        {
          "fieldPath": "tradeCount",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "Your position: how many ranked accounts have a higher discipline score than yours.",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "ranked",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "disciplineScore",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "comment": "Your conversations, most recent first.",
      "collectionGroup": "chats",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "uids",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "updatedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "A trader's open positions.",
      "collectionGroup": "trades",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "openedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "A trader's accepted connections, newest first.",
      "collectionGroup": "connections",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "uids",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "accepted",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "requestedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "Requests waiting on you to decide.",
      "collectionGroup": "connections",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "toUid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "accepted",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "requestedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "Who viewed a profile, most recent first.",
      "collectionGroup": "profileViews",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "profileUid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "viewedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "Your notifications, newest first, expired ones filtered out.",
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "recipientUid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "expiresAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "Unread badge count.",
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "recipientUid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "read",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "expiresAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "Feed pass one: posts by people you are connected to, newest first.",
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "authorUid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "expiresAt",
          "order": "DESCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": []
