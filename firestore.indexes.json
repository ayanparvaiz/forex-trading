{
  "comment": [
    "Composite indexes only. Firestore creates single-field indexes on its own",
    "and rejects any attempt to declare one, so a query ordered by a single",
    "field needs no entry here."
  ],
  "indexes": [
    {
      "comment": "Leaderboard reads profiles directly: discipline first, trade count as the tiebreak.",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "disciplineScore",
          "order": "DESCENDING"
        },
        {
          "fieldPath": "tradeCount",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "Feed filtered to one pair, newest first.",
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "symbol",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "postedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "Feed paged by expiry, so expired posts never reach a client.",
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "expiresAt",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "postedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "A trader's open positions.",
      "collectionGroup": "trades",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "openedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "Incoming connection requests awaiting a decision.",
      "collectionGroup": "connections",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "requestedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "comment": "Who viewed a profile, most recent first.",
      "collectionGroup": "profileViews",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "profileId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "viewedAt",
          "order": "DESCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": []
}
